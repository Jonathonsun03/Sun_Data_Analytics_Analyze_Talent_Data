    "#| label: deterministic-normalization\n",
    "\n",
    "COMPACT_TOKEN_ALIASES = {\n",
    "    \"masterduel\": \"master duel\",\n",
    "    \"subgoal\": \"sub goal\",\n",
    "    \"yugioh\": \"yu gi oh\",\n",
    "}\n",
    "\n",
    "\n",
    "def normalize_tag(value: object) -> str:\n",
    "    text = unicodedata.normalize(\"NFKC\", str(value)).casefold().strip()\n",
    "    text = text.replace(\"&\", \" and \")\n",
    "    text = re.sub(r\"[_/\\\\-]+\", \" \", text)\n",
    "    text = re.sub(r\"(?<=\\d)(?=[a-z])|(?<=[a-z])(?=\\d)\", \" \", text)\n",
    "    text = re.sub(r\"[^\\w\\s]\", \" \", text, flags=re.UNICODE)\n",
    "    text = re.sub(r\"\\s+\", \" \", text).strip()\n",
    "\n",
    "    tokens = text.split()\n",
    "    expanded: list[str] = []\n",
    "    for token in tokens:\n",
    "        expanded.extend(COMPACT_TOKEN_ALIASES.get(token, token).split())\n",
    "    tokens = [\"hour\" if token == \"hours\" else token for token in expanded]\n",
    "    return \" \".join(tokens)\n",
    "\n",
    "\n",
    "def numeric_signature(value: object) -> tuple[str, ...]:\n",
    "    normalized = normalize_tag(value)\n",
    "    return tuple(re.findall(r\"\\b\\d+(?:\\.\\d+)?\\s*k?\\b\", normalized))\n",
    "\n",
    "\n",
    "normalized_inventory = raw_inventory.copy()\n",
    "normalized_inventory[\"normalized_tag\"] = normalized_inventory[\"raw_tag\"].map(\n",
    "    normalize_tag\n",
    ")\n",
    "tag_rows[\"normalized_tag\"] = tag_rows[\"raw_tag\"].map(normalize_tag)\n",
    "normalized_groups = (\n",
    "    tag_rows.groupby(\"normalized_tag\", as_index=False)\n",
    "    .agg(\n",
    "        raw_variants=(\"raw_tag\", lambda values: \" | \".join(sorted(set(values)))),\n",
    "        variant_count=(\"raw_tag\", \"nunique\"),\n",
    "        uses=(\"video_id\", \"size\"),\n",
    "        unique_titles=(\"video_id\", \"nunique\"),\n",
    "    )\n",
    "    .sort_values([\"variant_count\", \"uses\"], ascending=[False, False])\n",
    "    .reset_index(drop=True)\n",
    ")\n",
    "\n",
    "normalization_summary = pd.DataFrame(\n",
    "    {\n",
    "        \"metric\": [\n",
    "            \"Distinct raw tags\",\n",
    "            \"Distinct normalized tags\",\n",
    "            \"Labels removed by deterministic normalization\",\n",
    "            \"Normalized groups with multiple raw spellings\",\n",
    "        ],\n",
    "        \"value\": [\n",
    "            len(raw_inventory),\n",
    "            len(normalized_groups),\n",
    "            len(raw_inventory) - len(normalized_groups),\n",
    "            int((normalized_groups[\"variant_count\"] > 1).sum()),\n",
    "        ],\n",
    "    }\n",
    ")\n",
    "normalization_summary"
   ]
