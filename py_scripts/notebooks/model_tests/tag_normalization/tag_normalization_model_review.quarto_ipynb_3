    "#| label: load-current-tags\n",
    "\n",
    "database_path = unified_database_path()\n",
    "connection = duckdb.connect(str(database_path), read_only=True)\n",
    "try:\n",
    "    result_rows = connection.execute(\n",
    "        \"\"\"\n",
    "        SELECT\n",
    "          result.video_id,\n",
    "          result.talent_code,\n",
    "          talent.talent_name,\n",
    "          video.title,\n",
    "          status.title_version_id,\n",
    "          result.classification_json,\n",
    "          result.created_at\n",
    "        FROM classification.title_classification_status AS status\n",
    "        JOIN classification.title_classification_results AS result\n",
    "          ON result.video_id = status.video_id\n",
    "         AND result.title_hash = status.title_hash\n",
    "         AND result.title_version_id = status.title_version_id\n",
    "        JOIN catalog.videos AS video\n",
    "          ON video.video_id = result.video_id\n",
    "        LEFT JOIN catalog.talents AS talent\n",
    "          ON talent.talent_code = result.talent_code\n",
    "        WHERE status.is_classified\n",
    "        QUALIFY ROW_NUMBER() OVER (\n",
    "          PARTITION BY result.video_id\n",
    "          ORDER BY result.created_at DESC NULLS LAST,\n",
    "                   result.confidence DESC NULLS LAST\n",
    "        ) = 1\n",
    "        ORDER BY result.video_id\n",
    "        \"\"\"\n",
    "    ).fetchdf()\n",
    "finally:\n",
    "    connection.close()\n",
    "\n",
    "\n",
    "def parse_classification(value: object) -> dict[str, object]:\n",
    "    if value is None or pd.isna(value):\n",
    "        return {}\n",
    "    try:\n",
    "        parsed = json.loads(str(value))\n",
    "    except (TypeError, ValueError, json.JSONDecodeError):\n",
    "        return {}\n",
    "    return parsed if isinstance(parsed, dict) else {}\n",
    "\n",
    "\n",
    "tag_records: list[dict[str, object]] = []\n",
    "for row in result_rows.itertuples(index=False):\n",
    "    classification = parse_classification(row.classification_json)\n",
    "    tags = classification.get(\"tags\", [])\n",
    "    if not isinstance(tags, list):\n",
    "        continue\n",
    "    for tag in tags:\n",
    "        tag_text = str(tag).strip()\n",
    "        if not tag_text:\n",
    "            continue\n",
    "        tag_records.append(\n",
    "            {\n",
    "                \"video_id\": row.video_id,\n",
    "                \"talent_code\": row.talent_code,\n",
    "                \"talent_name\": row.talent_name,\n",
    "                \"title\": row.title,\n",
    "                \"title_version_id\": row.title_version_id,\n",
    "                \"topic\": str(classification.get(\"topic\", \"\") or \"\"),\n",
    "                \"primary_reference\": str(\n",
    "                    classification.get(\"primary_reference\", \"\") or \"\"\n",
    "                ),\n",
    "                \"raw_tag\": tag_text,\n",
    "            }\n",
    "        )\n",
    "\n",
    "tag_rows = pd.DataFrame(tag_records)\n",
    "raw_inventory = (\n",
    "    tag_rows.groupby(\"raw_tag\", as_index=False)\n",
    "    .agg(\n",
    "        uses=(\"video_id\", \"size\"),\n",
    "        unique_titles=(\"video_id\", \"nunique\"),\n",
    "        talents=(\"talent_code\", \"nunique\"),\n",
    "    )\n",
    "    .sort_values([\"uses\", \"raw_tag\"], ascending=[False, True])\n",
    "    .reset_index(drop=True)\n",
    ")\n",
    "\n",
    "pd.DataFrame(\n",
    "    {\n",
    "        \"metric\": [\n",
    "            \"Current classified titles\",\n",
    "            \"Tag assignments\",\n",
    "            \"Distinct raw tags\",\n",
    "        ],\n",
    "        \"value\": [len(result_rows), len(tag_rows), len(raw_inventory)],\n",
    "    }\n",
    ")"
   ]
