      "source": [
        "## Build the final canonical mapping\n",
        "\n",
        "Each guarded RapidFuzz component receives one canonical label. The most-used\n",
        "normalized label wins; ties prefer the shorter label and then alphabetical\n",
        "order. This makes the choice deterministic and favors the spelling already\n",
        "most common in the current data."
      ],
      "id": "4b266e50"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "#| label: canonical-normalization-mapping\n",
        "\n",
        "component_members: dict[str, list[str]] = defaultdict(list)\n",
        "for normalized_tag, component_id in rapidfuzz_lookup.items():\n",
        "    component_members[component_id].append(normalized_tag)\n",
        "\n",
        "canonical_rows: list[dict[str, object]] = []\n",
        "for component_id, members in component_members.items():\n",
        "    canonical_tag = sorted(\n",
        "        members,\n",
        "        key=lambda tag: (\n",
        "            -int(normalized_metadata[tag][\"uses\"]),\n",
        "            len(tag),\n",
        "            tag,\n",
        "        ),\n",
        "    )[0]\n",
        "    for normalized_tag in members:\n",
        "        canonical_rows.append(\n",
        "            {\n",
        "                \"normalized_tag\": normalized_tag,\n",
        "                \"canonical_tag\": canonical_tag,\n",
        "                \"rapidfuzz_component\": component_id,\n",
        "                \"component_size\": len(members),\n",
        "            }\n",
        "        )\n",
        "\n",
        "canonical_mapping = pd.DataFrame(canonical_rows)\n",
        "final_tag_mapping = normalized_inventory.merge(\n",
        "    canonical_mapping,\n",
        "    on=\"normalized_tag\",\n",
        "    how=\"left\",\n",
        "    validate=\"many_to_one\",\n",
        ")\n",
        "\n",
        "\n",
        "def normalization_method(row: pd.Series) -> str:\n",
        "    deterministic_changed = row[\"raw_tag\"] != row[\"normalized_tag\"]\n",
        "    rapidfuzz_changed = row[\"normalized_tag\"] != row[\"canonical_tag\"]\n",
        "    if deterministic_changed and rapidfuzz_changed:\n",
        "        return \"deterministic_and_rapidfuzz\"\n",
        "    if rapidfuzz_changed:\n",
        "        return \"rapidfuzz\"\n",
        "    if deterministic_changed:\n",
        "        return \"deterministic\"\n",
        "    return \"unchanged\"\n",
        "\n",
        "\n",
        "final_tag_mapping[\"normalization_method\"] = final_tag_mapping.apply(\n",
        "    normalization_method,\n",
        "    axis=1,\n",
        ")\n",
        "\n",
        "canonical_inventory = (\n",
        "    final_tag_mapping.groupby(\"canonical_tag\", as_index=False)\n",
        "    .agg(\n",
        "        uses=(\"uses\", \"sum\"),\n",
        "        raw_tag_count=(\"raw_tag\", \"nunique\"),\n",
        "        deterministic_tag_count=(\"normalized_tag\", \"nunique\"),\n",
        "        raw_variants=(\n",
        "            \"raw_tag\",\n",
        "            lambda values: \" | \".join(sorted(set(values))),\n",
        "        ),\n",
        "    )\n",
        "    .sort_values([\"uses\", \"canonical_tag\"], ascending=[False, True])\n",
        "    .reset_index(drop=True)\n",
        ")\n",
        "\n",
        "normalization_result_summary = pd.DataFrame(\n",
        "    {\n",
        "        \"metric\": [\n",
        "            \"Distinct raw tags\",\n",
        "            \"Tags after deterministic normalization\",\n",
        "            \"Final canonical tags\",\n",
        "            \"Deterministic consolidations\",\n",
        "            \"Additional guarded RapidFuzz consolidations\",\n",
        "        ],\n",
        "        \"value\": [\n",
        "            len(raw_inventory),\n",
        "            len(normalized_groups),\n",
        "            len(canonical_inventory),\n",
        "            len(raw_inventory) - len(normalized_groups),\n",
        "            len(normalized_groups) - len(canonical_inventory),\n",
        "        ],\n",
        "    }\n",
        ")\n",
        "normalization_result_summary"
      ],
      "id": "canonical-normalization-mapping",
      "execution_count": null,
      "outputs": []
    },
