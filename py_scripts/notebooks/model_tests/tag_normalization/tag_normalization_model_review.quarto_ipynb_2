        "## Small review benchmark\n",
        "\n",
        "This benchmark is intentionally narrow. It tests the examples that motivated\n",
        "the analysis and includes nearby hard negatives. Expand it through human review\n",
        "before treating any reported score as a production-quality estimate."
      ],
      "id": "c5511f1a"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "#| label: benchmark-definition\n",
        "\n",
        "BENCHMARK_ALIAS_GROUPS = {\n",
        "    \"twelve_hour_surface\": [\"12_hours\", \"12-hours\"],\n",
        "    \"subscriber_goal_base\": [\"sub_goal\"],\n",
        "    \"subscriber_goal_15k\": [\"15k_sub_goal\", \"15k-sub-goal\"],\n",
        "    \"subscriber_goal_20k\": [\"20k_sub_goal\", \"20k-sub-goal\"],\n",
        "    \"subscriber_count_15k\": [\"15k_subs\", \"15k-subs\"],\n",
        "    \"yugioh_surface\": [\n",
        "        \"yugioh\",\n",
        "        \"yu-gi-oh\",\n",
        "        \"Yu-Gi-Oh\",\n",
        "        \"Yu-Gi-Oh!\",\n",
        "    ],\n",
        "    \"master_duel_surface\": [\n",
        "        \"master_duel\",\n",
        "        \"masterduel\",\n",
        "        \"Master Duel\",\n",
        "    ],\n",
        "    \"yugioh_master_duel_surface\": [\n",
        "        \"Yu-Gi-Oh Master Duel\",\n",
        "        \"Yu-Gi-Oh! Master Duel\",\n",
        "    ],\n",
        "    \"duelist_cup_surface\": [\n",
        "        \"duelist_cup\",\n",
        "        \"Duelist Cup\",\n",
        "    ],\n",
        "    \"cardfight_vanguard_spacing\": [\n",
        "        \"cardfight vanguard\",\n",
        "        \"cardfightvanguard\",\n",
        "    ],\n",
        "    \"yugioh_player_number\": [\n",
        "        \"yugioh_player\",\n",
        "        \"yugioh_players\",\n",
        "    ],\n",
        "    \"challenge_run_number\": [\n",
        "        \"challenge_run\",\n",
        "        \"challenge_runs\",\n",
        "    ],\n",
        "    \"just_chatting_typo\": [\n",
        "        \"just_chatting\",\n",
        "        \"just_chattin\",\n",
        "    ],\n",
        "}\n",
        "\n",
        "benchmark_rows = []\n",
        "available_raw_tags = set(raw_inventory[\"raw_tag\"])\n",
        "for expected_alias_group, variants in BENCHMARK_ALIAS_GROUPS.items():\n",
        "    for raw_tag in variants:\n",
        "        if raw_tag in available_raw_tags:\n",
        "            benchmark_rows.append(\n",
        "                {\n",
        "                    \"raw_tag\": raw_tag,\n",
        "                    \"normalized_tag\": normalize_tag(raw_tag),\n",
        "                    \"expected_alias_group\": expected_alias_group,\n",
        "                }\n",
        "            )\n",
        "\n",
        "benchmark = pd.DataFrame(benchmark_rows).drop_duplicates(\"raw_tag\")\n",
        "benchmark"
      ],
      "id": "benchmark-definition",
      "execution_count": null,
      "outputs": []
    },
