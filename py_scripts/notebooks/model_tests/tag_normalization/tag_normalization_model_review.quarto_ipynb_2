        "    {\n",
        "        \"method\": \"deterministic_exact\",\n",
        "        **evaluate_cluster_lookup(benchmark, exact_lookup),\n",
        "    },\n",
        "    {\n",
        "        \"method\": \"rapidfuzz_strong_alias_candidates\",\n",
        "        **evaluate_cluster_lookup(benchmark, rapidfuzz_lookup),\n",
