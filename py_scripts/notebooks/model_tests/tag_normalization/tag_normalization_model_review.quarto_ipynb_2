      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Stage 2: RapidFuzz candidate generation\n",
        "\n",
        "RapidFuzz is used only after deterministic normalization. Strong lexical\n",
        "matches are automatically consolidated when both direct and token scores meet\n",
        "the high-confidence cutoff and neither numbers nor token containment differ.\n",
        "Other matches remain unchanged because high lexical similarity can describe a\n",
        "broader family or compound tag instead of an alias."
      ],
      "id": "559016dc"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "#| label: rapidfuzz-candidates\n",
        "\n",
        "normalized_labels = normalized_groups[\"normalized_tag\"].tolist()\n",
        "normalized_metadata = normalized_groups.set_index(\"normalized_tag\").to_dict(\n",
        "    \"index\"\n",
        ")\n",
        "fuzzy_rows: list[dict[str, object]] = []\n",
        "\n",
        "for left_index, left_tag in enumerate(normalized_labels):\n",
        "    matches = process.extract(\n",
        "        left_tag,\n",
        "        normalized_labels,\n",
        "        scorer=fuzz.WRatio,\n",
        "        score_cutoff=FUZZY_SCORE_CUTOFF,\n",
        "        limit=20,\n",
        "    )\n",
        "    for right_tag, weighted_score, right_index in matches:\n",
        "        if right_index <= left_index:\n",
        "            continue\n",
        "        ratio_score = float(fuzz.ratio(left_tag, right_tag))\n",
        "        token_score = float(fuzz.token_ratio(left_tag, right_tag))\n",
        "        left_numbers = numeric_signature(left_tag)\n",
        "        right_numbers = numeric_signature(right_tag)\n",
        "        numeric_difference = left_numbers != right_numbers\n",
        "        left_tokens = set(left_tag.split())\n",
        "        right_tokens = set(right_tag.split())\n",
        "        token_containment = (\n",
        "            left_tokens != right_tokens\n",
        "            and (\n",
        "                left_tokens.issubset(right_tokens)\n",
        "                or right_tokens.issubset(left_tokens)\n",
        "            )\n",
        "        )\n",
        "\n",
        "        if numeric_difference:\n",
        "            relationship_hint = \"numeric_or_scope_review\"\n",
        "        elif token_containment:\n",
        "            relationship_hint = \"compound_or_family_review\"\n",
        "        elif (\n",
        "            ratio_score >= FUZZY_HIGH_CONFIDENCE_CUTOFF\n",
        "            and token_score >= FUZZY_HIGH_CONFIDENCE_CUTOFF\n",
        "        ):\n",
        "            relationship_hint = \"strong_alias_candidate\"\n",
        "        else:\n",
        "            relationship_hint = \"lexical_review\"\n",
        "\n",
        "        left_metadata = normalized_metadata[left_tag]\n",
        "        right_metadata = normalized_metadata[right_tag]\n",
        "        fuzzy_rows.append(\n",
        "            {\n",
        "                \"left_tag\": left_tag,\n",
        "                \"right_tag\": right_tag,\n",
        "                \"left_uses\": int(left_metadata[\"uses\"]),\n",
        "                \"right_uses\": int(right_metadata[\"uses\"]),\n",
        "                \"left_variants\": left_metadata[\"raw_variants\"],\n",
        "                \"right_variants\": right_metadata[\"raw_variants\"],\n",
        "                \"ratio\": ratio_score,\n",
        "                \"token_ratio\": token_score,\n",
        "                \"weighted_ratio\": float(weighted_score),\n",
        "                \"numeric_difference\": numeric_difference,\n",
        "                \"token_containment\": token_containment,\n",
        "                \"relationship_hint\": relationship_hint,\n",
        "            }\n",
        "        )\n",
        "\n",
        "fuzzy_candidates = pd.DataFrame(fuzzy_rows)\n",
        "if not fuzzy_candidates.empty:\n",
        "    fuzzy_candidates = fuzzy_candidates.sort_values(\n",
        "        [\"relationship_hint\", \"weighted_ratio\", \"token_ratio\"],\n",
        "        ascending=[True, False, False],\n",
        "    ).reset_index(drop=True)\n",
        "\n",
        "candidate_summary = (\n",
        "    fuzzy_candidates.groupby(\"relationship_hint\", as_index=False)\n",
        "    .size()\n",
        "    .sort_values(\"size\", ascending=False)\n",
        ")\n",
        "candidate_summary"
      ],
      "id": "rapidfuzz-candidates",
      "execution_count": null,
      "outputs": []
    },
